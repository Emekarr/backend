# Copy this file to backend/.env. Keep this file free of real credentials.
# Required unless marked optional. Generate independent encryption keys for JWT, TOTP, and Paystack.

# Runtime
NODE_ENV=development
SERVICE_NAME=danvic-api
LOG_LEVEL=debug
PORT=3000

# Required infrastructure
MONGODB_URI=mongodb://127.0.0.1:27017/danvic
REDIS_URI=redis://127.0.0.1:6379

# Required authentication and encryption
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Required email delivery
RESEND_API_KEY=
EMAIL_FROM="DANVIC <admin@your-verified-domain.example>"

# Required app origins and callback URLs. Use HTTPS public URLs in production.
ADMIN_APP_BASE_URL=http://127.0.0.1:3001
AUTHOR_APP_BASE_URL=http://127.0.0.1:3002
STUDENT_APP_BASE_URL=http://127.0.0.1:3003
CORS_ORIGINS=http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003

# Required Paystack configuration; keep these server-side only.
# Server-side only. Never expose this key to a frontend.
PAYSTACK_SECRET_KEY=sk_test_replaceme
# Generate separately from the TOTP key with: openssl rand -base64 32
PAYSTACK_AUTHORIZATION_ENCRYPTION_KEY=
# Optional outside production; production must use https://api.paystack.co.
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_MS=10000

# Required Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public base URL for the R2 bucket (custom domain or public bucket URL).
# When set, uploads include a permanent publicUrl so images can be embedded in documents.
R2_PUBLIC_BASE_URL=

# Optional live-class RTC. Set both values to enable Agora video/audio rooms.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional Cloud Recording. Requires AGORA_APP_ID and AGORA_APP_CERTIFICATE too.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Optional Agora Whiteboard / Netless.
NETLESS_APP_IDENTIFIER=
NETLESS_SDK_TOKEN=
# Optional Cloudflare Stream playback. Without it, recordings use signed R2 playback URLs.
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# Optional runtime tuning
SHUTDOWN_TIMEOUT_MS=10000

# Optional first-run bootstrap. Omit all four to skip automatic super-admin creation.
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-secure-password
